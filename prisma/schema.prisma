// fic-invoicing data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FiscalRegime {
  FORFETTARIO
  ORDINARIO
}

enum CustomerCategory {
  IT_PRIVATE
  EU_PRIVATE
  EXTRAEU_PRIVATE
  IT_BUSINESS
  /// Business in another EU country (reverse charge). Used by the invoices to Apple, not by the public API.
  EU_BUSINESS
}

enum AppStoreReportStatus {
  /// Downloaded, waiting for the admin to issue the invoice.
  READY
  /// An invoice was issued from it.
  INVOICED
  /// Invoiced elsewhere, by hand.
  DISMISSED
}

/// How the €2 stamp duty (imposta di bollo) is handled on FORFETTARIO invoices above €77.47.
/// On e-invoices FIC never adds `stamp_duty` to the amount due: it only declares the virtual stamp.
enum StampDutyMode {
  /// Charged to the customer with a separate €2 "Rimborso imposta di bollo" line: the customer pays amount + €2.
  /// Needs a stamp duty VAT type.
  CHARGED_TO_CUSTOMER
  /// Borne by the seller: the line is amountCents, the customer pays amount, the €2 is only declared.
  INCLUDED
  /// Never applied.
  DISABLED
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
  /// Deleted from Fatture in Cloud by an admin. The row is kept for audit.
  DELETED
}

/// One Fatture in Cloud OAuth authorization. Several can be connected; each can reach several companies.
/// Tokens are AES-256-GCM encrypted. FIC rotates refresh tokens, so they live here once and every
/// project using one of this account's companies shares them.
model FicAccount {
  id              String    @id @default(cuid())
  /// Shown in the admin: the FIC user's name or email, editable.
  label           String
  /// FIC user id, from /user/info. Reconnecting the same user updates this row instead of adding one.
  ficUserId       Int?      @unique
  ficUserEmail    String?
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  tokenExpiresAt  DateTime?
  connectedAt     DateTime?
  /// Set when a token refresh is rejected by FIC: an admin must reconnect.
  needsReconnect  Boolean   @default(false)
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  companies       Company[]

  @@map("fic_accounts")
}

/// A Fatture in Cloud company reached through an account, with the invoice settings its projects inherit.
model Company {
  id           String     @id @default(cuid())
  accountId    String
  account      FicAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ficCompanyId Int
  name         String

  /// A fact of the company: projects cannot override it.
  fiscalRegime        FiscalRegime  @default(FORFETTARIO)
  /// VAT type used for invoice lines (FORFETTARIO: all categories; ORDINARIO: Italian customers).
  vatTypeId           Int?
  /// ORDINARIO only: VAT type for operations outside the scope of Italian VAT (art. 7-ter, EU / extra-EU private customers).
  nonTaxableVatTypeId Int?
  paymentAccountId    Int?
  paymentMethodId     Int?
  /// FIC numeration suffix, for example "/A". Null uses the company default numeration.
  numeration          String?
  /// Item code printed on the invoice line. Null leaves it empty.
  itemCode            String?
  /// Per-category overrides of the fiscal statement text: { "IT_PRIVATE": "...", ... }. Null uses presets.
  fiscalStatements    Json?
  /// SDI ModalitaPagamento code. MP08 = payment card.
  eiPaymentMethod     String        @default("MP08")
  /// €2 stamp duty (imposta di bollo) on FORFETTARIO invoices above €77.47: on top, included or disabled.
  stampDutyMode       StampDutyMode @default(CHARGED_TO_CUSTOMER)
  /// VAT type of the "Rimborso imposta di bollo" line (excluded under art. 15 DPR 633/72). Required by CHARGED_TO_CUSTOMER.
  stampDutyVatTypeId  Int?
  /// After a real (non dry-run) invoice is created, ask FIC to send it to SDI.
  sendToSdi           Boolean       @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  invoices      Invoice[]
  appleAccounts AppleAccount[]

  @@unique([accountId, ficCompanyId])
  @@map("companies")
}

/// An app that calls the API with its own key. It issues invoices from a company and inherits the
/// company's settings: every nullable setting below is an override, null means "use the company value".
model Project {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  /// sha256 hex of the plaintext API key. The plaintext is shown once.
  apiKeyHash   String   @unique @db.Char(64)
  /// First characters of the key, to help admins recognise it. Not secret.
  apiKeyPrefix String   @default("")
  active       Boolean  @default(true)
  /// When true every invoice is a dry run: validated with FIC's totals endpoint, nothing is created in FIC.
  dryRun       Boolean  @default(true)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // --- Overrides of the company settings (null = inherit) ---
  vatTypeId           Int?
  nonTaxableVatTypeId Int?
  paymentAccountId    Int?
  paymentMethodId     Int?
  /// "" overrides with "no suffix" (the company default numeration).
  numeration          String?
  /// "" overrides with "no item code".
  itemCode            String?
  /// Per-category texts; a category missing here uses the company text, then the regime preset.
  fiscalStatements    Json?
  eiPaymentMethod     String?
  stampDutyMode       StampDutyMode?
  stampDutyVatTypeId  Int?
  sendToSdi           Boolean?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoices      Invoice[]
  appleApps     AppleApp[]
  appleProducts AppleProduct[]

  @@index([companyId])
  @@map("projects")
}

model Invoice {
  id               String           @id @default(cuid())
  /// Null for invoices to Apple, which belong to an Apple account.
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appleAccountId   String?
  appleAccount     AppleAccount?    @relation(fields: [appleAccountId], references: [id], onDelete: Restrict)
  /// The company that issued it: deleting it or resending it to SDI talks to this company.
  companyId        String?
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  idempotencyKey   String           @db.VarChar(191)
  externalRef      String?          @db.VarChar(191)
  status           InvoiceStatus    @default(PENDING)
  customerCategory CustomerCategory
  /// Amount for the service, EUR cents. VAT-inclusive for ORDINARIO Italian customers.
  amountCents      Int
  stampDutyCents   Int              @default(0)
  description      String           @db.Text
  ficDocumentId    Int?
  /// Full invoice number as printed, for example "12/A".
  ficNumber        String?
  dryRun           Boolean
  errorMessage     String?          @db.Text
  attempts         Int              @default(0)
  /// Data needed to retry: contains the customer's personal data.
  /// Nulled once the invoice is ISSUED when PURGE_PAYLOAD_ON_SUCCESS=true (default).
  requestPayload   Json?
  sdiSentAt        DateTime?
  sdiError         String?          @db.Text
  /// When an admin deleted the document from Fatture in Cloud (status DELETED).
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  appStoreReport AppStoreReport?

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([companyId])
  @@index([appleAccountId])
  @@map("invoices")
}

/// An Apple developer account (App Store Connect) whose apps belong to one or more projects. Apple pays
/// it once per fiscal month for all its apps, and is invoiced once per report, one line per project.
model AppleAccount {
  id               String           @id @default(cuid())
  label            String
  issuerId         String
  keyId            String
  /// The .p8 private key of the team API key (Finance access), AES-256-GCM encrypted.
  privateKeyEnc    String           @db.Text
  vendorNumber     String
  /// The Fatture in Cloud company that issues the invoices to Apple.
  companyId        String?
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// When true the invoices to Apple are only validated, nothing is created in Fatture in Cloud.
  dryRun           Boolean          @default(true)
  // --- Invoice to Apple ---
  /// { name, vatNumber, address, zipCode, city, province, countryCode }
  customer         Json
  itemName         String           @default("Distribuzione applicazioni mobili")
  vatTypeId        Int?
  paymentAccountId Int?
  paymentMethodId  Int?
  /// SDI ModalitaPagamento code. MP05 = bank transfer.
  eiPaymentMethod  String           @default("MP05")
  statement        String?          @db.Text
  /// First Apple fiscal period ("<fiscal year>-<period>") not settled yet.
  nextPeriod       String
  lastCheckedAt    DateTime?
  lastError        String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  apps             AppleApp[]
  products         AppleProduct[]
  reports          AppStoreReport[]
  invoices         Invoice[]

  @@map("apple_accounts")
}

/// An app of an Apple account (from the App Store Connect API), and the project it belongs to.
model AppleApp {
  id                 String         @id @default(cuid())
  accountId          String
  account            AppleAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Apple app id.
  appleId            String
  sku                String
  name               String
  projectId          String?
  project            Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Name of its invoice line; null uses the account's line name.
  invoiceItemName    String?
  /// Description of its invoice line, with {periodo} and {transaction}; null uses the default text.
  invoiceDescription String?        @db.Text
  products           AppleProduct[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([accountId, appleId])
  @@index([projectId])
  @@map("apple_apps")
}

/// A product sold through an Apple account, as named in its reports (for an in-app purchase, the
/// purchase, not the app). It belongs to the project of its app; a product whose app is unknown
/// can be assigned to a project directly.
model AppleProduct {
  id        String       @id @default(cuid())
  accountId String
  account   AppleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "Apple Identifier" of the report.
  appleId   String
  /// "Vendor Identifier" (SKU) of the report.
  sku       String
  title     String
  /// The app it belongs to: itself for a paid app, the parent app for an in-app purchase.
  appId     String?
  app       AppleApp?    @relation(fields: [appId], references: [id], onDelete: SetNull)
  /// Used only when the app is unknown.
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([accountId, appleId])
  @@index([projectId])
  @@index([appId])
  @@map("apple_products")
}

/// An Apple financial report of one fiscal period, and the invoice issued from it.
model AppStoreReport {
  id             String               @id @default(cuid())
  accountId      String
  account        AppleAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "<fiscal year>-<period>", the reportDate of the App Store Connect API.
  period         String
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  /// [{ appleId, sku, title, currency, amount, units, countries }], partner share in the sale currency.
  lines          Json
  /// { date, rates: { USD: 1.11 } }: ECB reference rates (units per euro) of the day the report was found.
  ecbRates       Json?
  /// Euro estimate with the ECB rates; null when a currency has no ECB rate.
  estimatedCents Int?
  status         AppStoreReportStatus @default(READY)
  detectedAt     DateTime             @default(now())
  invoiceId      String?              @unique
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([accountId, period])
  @@map("app_store_reports")
}
