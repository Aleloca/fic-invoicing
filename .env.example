# --- Database -----------------------------------------------------------------
# docker compose overrides this to point at the bundled MySQL service.
DATABASE_URL="mysql://fic:change-me@127.0.0.1:3307/fic_invoicing"

# --- Secrets ------------------------------------------------------------------
# 32 random bytes, base64. Encrypts FIC tokens at rest. Generate: openssl rand -base64 32
# Changing it makes stored tokens unreadable (tenants must reconnect).
ENCRYPTION_KEY=""
# At least 32 characters. Signs the admin session cookie and the OAuth state. Generate: openssl rand -base64 48
SESSION_SECRET=""
# Password for the /admin panel.
ADMIN_PASSWORD=""

# --- Fatture in Cloud OAuth app (one per instance) ----------------------------
FIC_CLIENT_ID=""
FIC_CLIENT_SECRET=""
# Public URL of this service, no trailing slash. The OAuth redirect URI is
# ${PUBLIC_BASE_URL}/api/oauth/fic/callback
PUBLIC_BASE_URL="http://localhost:3000"

# --- Optional -----------------------------------------------------------------
# Null the stored request payload (customer personal data) once an invoice is ISSUED.
PURGE_PAYLOAD_ON_SUCCESS="true"
# Requests per minute per API key (in-memory, per process).
RATE_LIMIT_PER_MINUTE="60"
# Override only for testing against a mock server.
# FIC_API_BASE_URL="https://api-v2.fattureincloud.it"

# --- docker compose only ------------------------------------------------------
MYSQL_ROOT_PASSWORD="change-me-root"
MYSQL_DATABASE="fic_invoicing"
MYSQL_USER="fic"
MYSQL_PASSWORD="change-me"
# MYSQL_HOST_PORT=3307
# APP_PORT=3000

# --- Tests only ---------------------------------------------------------------
# Integration tests run only when this is set; the database name must contain "test"
# and is wiped by the tests.
# TEST_DATABASE_URL="mysql://root:change-me-root@127.0.0.1:3307/fic_invoicing_test"
