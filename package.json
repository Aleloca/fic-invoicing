{
  "name": "fic-invoicing",
  "version": "0.1.0",
  "description": "Self-hostable multi-tenant HTTP service that issues Italian electronic invoices through the Fatture in Cloud API v2.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
